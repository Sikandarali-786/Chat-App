{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    /* Module */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    /* Interoperability */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    /* Output */
    "sourceMap": true,
    /* Performance */
    "skipLibCheck": true,
    /* Types */
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}